# Monorepo: patterns are unanchored so they match in every workspace package.

# dependencies
node_modules/
.pnp
.pnp.*

# testing
coverage/

# sim run folders (pnpm sim --out); reproducible from their seed
runs/

# next.js
.next/
out/
next-env.d.ts

# production
build/
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (templates are committed)
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
